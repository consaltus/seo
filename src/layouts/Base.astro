---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang, RouteKey } from '../i18n/ui';
import { localizedPath, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  routeKey?: RouteKey;
  path?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  ctaHref?: string;
}

const props = Astro.props;
const t = useTranslations(props.lang);
const altLang: Lang = props.lang === 'de' ? 'en' : 'de';
const altHref = localizedPath(props.routeKey ?? 'home', altLang);
---

<!doctype html>
<html lang={props.lang === 'de' ? 'de-AT' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf7f2" />
    <SEOHead {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={props.lang} altHref={altHref} altLang={altLang} ctaHref={props.ctaHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={props.lang} altHref={altHref} altLang={altLang} />
  </body>
</html>
