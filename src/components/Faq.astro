---
import { faq } from '../config/content';
const icons: Record<string, string> = {
  euro: '<circle cx="11" cy="11" r="8.5"></circle><path d="M14 7.5 a4 4 0 1 0 0 7 M6.5 10 H11.5 M6.5 12.3 H11"></path>',
  clock: '<circle cx="11" cy="11" r="8.5"></circle><path d="M11 6.5 V11 L14 13"></path>',
  chart: '<path d="M3 18.5 H19 M5 15 L9 10.5 L12.5 13 L18 6.5"></path>',
  code: '<rect x="2.5" y="4" width="17" height="14" rx="3"></rect><path d="M8.5 9 L6 11 L8.5 13 M13.5 9 L16 11 L13.5 13"></path>',
  key: '<circle cx="7.5" cy="11" r="4"></circle><path d="M11.5 11 H19 M16 11 V14 M18.5 11 V13.5"></path>',
  lock: '<rect x="4.5" y="10" width="13" height="9" rx="2.5"></rect><path d="M7.5 10 V7.5 a3.5 3.5 0 0 1 7 0 V10"></path>',
};
---
<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="faq-panel">
      <div class="faq-intro">
        <span class="ico" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 28 28"><rect x="3" y="5" width="22" height="15" rx="5" fill="none" stroke="#8C4A2B" stroke-width="1.5"></rect><path d="M9 20 L8 25 L14 20" fill="none" stroke="#8C4A2B" stroke-width="1.5" stroke-linejoin="round"></path><path d="M11.5 10.5 a2.5 2.5 0 1 1 3.5 2.3 c-.7.3-1 .8-1 1.5" fill="none" stroke="#8C4A2B" stroke-width="1.5" stroke-linecap="round"></path><circle cx="14" cy="16.8" r=".9" fill="#8C4A2B"></circle></svg></span>
        <h2 id="faq-title" class="h2">Fragen, <span class="muted">bevor wir anfangen.</span></h2>
        <p>Was die Zusammenarbeit für Ihr Hotel bedeutet: Kosten, Aufwand und was wir von Ihnen brauchen.</p>
      </div>
      <div class="faq-list">
        {faq.map((f, i) => (
          <div data-faq>
            <button class="faq-q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>
              <svg class="i" viewBox="0 0 22 22" aria-hidden="true" set:html={icons[f.icon]} />
              <span>{f.q}</span>
              <svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6 L8 10 L12 6"></path></svg>
            </button>
            <p class="faq-a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} hidden={i !== 0}>{f.a}</p>
          </div>
        ))}
        <div class="faq-more">
          <span>Noch Fragen? Schreiben Sie uns.</span>
          <a class="btn btn-sm" href="#kontakt">Kontakt</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const qs = Array.from(document.querySelectorAll<HTMLElement>('[data-faq]'));
  qs.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-q')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      qs.forEach((o) => {
        o.querySelector('.faq-q')!.setAttribute('aria-expanded', 'false');
        (o.querySelector('.faq-a') as HTMLElement).hidden = true;
      });
      if (!open) {
        btn.setAttribute('aria-expanded', 'true');
        (item.querySelector('.faq-a') as HTMLElement).hidden = false;
      }
    });
  });
</script>
