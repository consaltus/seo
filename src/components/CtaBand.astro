---
interface Props {
  text: string;
  label: string;
  href?: string;
}
const { text, label, href = '#kontakt' } = Astro.props;
---

<div class="container">
  <div class="cta-band">
    <p>{text}</p>
    <a class="btn" href={href}>{label}</a>
  </div>
</div>

<style>
  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  p {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.3;
    max-width: 36ch;
  }
</style>
