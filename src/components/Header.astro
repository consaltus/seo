---
interface Props { plain?: boolean; home?: boolean }
const { plain = false, home = true } = Astro.props;
const p = home ? '' : '/';
---
<header class:list={['site-header', { 'is-plain': plain }]}>
  <div class="wrap bar">
    <a href="/" class="logo">Random Room</a>
    <nav class="nav" id="hauptmenue" aria-label="Hauptnavigation">
      <a class="nav-link" href={`${p}#leistungen`}>Leistungen</a>
      <a class="nav-link" href={`${p}#faq`}>FAQ</a>
      <a class="nav-link" href={`${p}#ueber-mich`}>Über mich</a>
      <a class="btn btn-sm nav-cta" href={`${p}#kontakt`}>Termin vereinbaren</a>
    </nav>
    <button class="burger" type="button" aria-controls="hauptmenue" aria-expanded="false" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const btn = header?.querySelector<HTMLButtonElement>('.burger');
  const nav = header?.querySelector<HTMLElement>('.nav');
  if (header && btn && nav) {
    const set = (open: boolean) => {
      header.classList.toggle('menu-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    };
    btn.addEventListener('click', () => set(!header.classList.contains('menu-open')));
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('menu-open')) { set(false); btn.focus(); }
    });
    document.addEventListener('click', (e) => {
      if (header.classList.contains('menu-open') && !header.contains(e.target as Node)) set(false);
    });
    matchMedia('(min-width: 761px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }
</script>
