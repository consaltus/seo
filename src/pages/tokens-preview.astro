---
// Nur zur Auswahl von Akzentfarbe und Schriftpaar. Wird nach der Entscheidung gelöscht.
import '@fontsource-variable/newsreader';
import '@fontsource-variable/public-sans';
import Base from '../layouts/Base.astro';

const variants = [
  { accent: 'a', fonts: '1', label: 'Akzent A #0E4F5C · Fraunces + Source Sans 3' },
  { accent: 'a', fonts: '2', label: 'Akzent A #0E4F5C · Newsreader + Public Sans' },
  { accent: 'b', fonts: '1', label: 'Akzent B #006B6E · Fraunces + Source Sans 3' },
  { accent: 'b', fonts: '2', label: 'Akzent B #006B6E · Newsreader + Public Sans' },
];
---

<Base title="Token-Vorschau" description="Interne Vorschau der Design-Varianten." lang="de" path="/tokens-preview/" noindex>
  <div class="container grid">
    {
      variants.map((v) => (
        <section class="variant" data-accent={v.accent} data-fonts={v.fonts}>
          <p class="label">{v.label}</p>
          <h1>Mehr Direktbuchungen am Wörthersee</h1>
          <p class="lead">
            Gäste entscheiden in Google, Google Maps und KI-Assistenten. Dort steht bei vielen Hotels ein alter Name.
            Der offizielle Link fehlt im Preisblock.
          </p>
          <a class="btn" href="#">Termin vereinbaren</a>
          <h2>Was wir bei anderen Hotels gefunden haben</h2>
          <div class="card">
            <h3>Sichtbarkeitscheck</h3>
            <p>Prüfung von Website, Google-Profil, Preisblock, Bewertungen und KI-Antworten. Bericht mit Prioritäten.</p>
            <a href="#">Link im Fließtext</a>
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .grid { display: grid; gap: var(--space-6); padding-block: var(--space-7); }
  @media (min-width: 60rem) { .grid { grid-template-columns: 1fr 1fr; } }
  .variant {
    display: grid; gap: var(--space-4); align-content: start;
    padding: var(--space-6); border: 1px solid var(--color-line); border-radius: var(--radius-l);
    font-family: var(--font-body);
  }
  .variant h1 { font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem); }
  .label { font-size: var(--text-sm); color: var(--color-muted); }
  .lead { font-size: var(--text-lg); }
  .btn { justify-self: start; }
  .card { background: var(--color-surface); border-radius: var(--radius-m); padding: var(--space-5); display: grid; gap: var(--space-2); }
</style>
