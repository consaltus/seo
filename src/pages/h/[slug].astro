---
// Persönliche Befundseite für ein Hotel. noindex, nicht in Sitemap oder Navigation.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('hotels');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { hotel, lang, demo, checkedAt, issues, slug } = entry.data;
const t = useTranslations(lang);
const fill = (s: string) => s.replace('{hotel}', hotel);
const { Content } = await render(entry);
---

<Base
  title={fill(t('hotel.title'))}
  description={fill(t('hotel.description'))}
  lang={lang}
  path={`/h/${slug}/`}
  noindex
  ctaHref="#kontakt"
>
  {demo && <p class="demo">{t('hotel.demo')}</p>}

  <section class="container intro">
    <h1>{fill(t('hotel.title'))}</h1>
    <div class="lead"><Content /></div>
    {checkedAt && <p class="checked">{t('hotel.checked')}: {checkedAt}</p>}
  </section>

  <section class="container issues" aria-labelledby="issues-title">
    <h2 id="issues-title">{t('hotel.findingsTitle')}</h2>
    <ol>
      {
        issues.map((issue, i) => (
          <li class="issue">
            <div class="text">
              <p class="no">{i + 1}</p>
              <h3>{issue.title}</h3>
              <p class="where">
                {t('hotel.where')}: {issue.where}
              </p>
              <p>{issue.text}</p>
            </div>
            <figure>
              {issue.screenshot ? (
                <Image src={issue.screenshot} alt={issue.screenshotAlt ?? ''} widths={[480, 800]} sizes="(min-width: 56rem) 50vw, 100vw" />
              ) : (
                <div class="shot-missing">
                  {t('hotel.screenshotMissing')}
                  <br />
                  {issue.screenshotAlt}
                </div>
              )}
            </figure>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="offer">
    <div class="container offer-inner">
      <h2>{t('hotel.offerTitle')}</h2>
      <p>{t('hotel.offerText')}</p>
    </div>
  </section>

  <section class="container contact" id="kontakt" aria-labelledby="contact-title">
    <h2 id="contact-title">{t('hotel.formTitle')}</h2>
    <ContactForm lang={lang} hotel={hotel} source={`h/${slug}`} />
  </section>
</Base>

<style>
  .demo {
    background: var(--color-accent-soft);
    color: var(--color-text);
    font-weight: 600;
    text-align: center;
    padding: var(--space-3) var(--gutter);
    border-bottom: 1px solid var(--color-line);
  }
  .intro {
    padding-block: var(--section-normal) var(--space-7);
    display: grid;
    gap: var(--space-5);
  }
  .intro h1 {
    max-width: 18ch;
  }
  .lead {
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-lg);
    max-width: var(--measure);
  }
  .checked {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .issues {
    padding-bottom: var(--section-normal);
    display: grid;
    gap: var(--space-6);
  }
  .issues ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .issue {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 56rem) {
    .issue {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
  }
  .text {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }
  .no {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1;
    color: var(--color-accent);
  }
  .where {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  figure {
    margin: 0;
  }
  figure :global(img) {
    border-radius: var(--radius-m);
    border: 1px solid var(--color-line);
  }
  .shot-missing {
    aspect-ratio: 16 / 10;
    border: 1px dashed var(--color-muted);
    border-radius: var(--radius-m);
    display: grid;
    place-content: center;
    text-align: center;
    padding: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .offer {
    background: var(--color-surface);
    padding-block: var(--section-tight);
  }
  .offer-inner {
    display: grid;
    gap: var(--space-4);
  }
  .offer-inner p {
    font-size: var(--text-lg);
    max-width: var(--measure);
  }
  .contact {
    padding-block: var(--section-normal);
    display: grid;
    gap: var(--space-6);
  }
</style>
