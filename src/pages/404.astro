---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import MiniFooter from '../components/MiniFooter.astro';
---
<Base title="Seite nicht gefunden – Random Room" noindex>
  <div class="legal-top">
    <Header home={false} />
    <main id="main" class="simple">
      <div class="wrap inner">
        <p class="eyebrow">Fehler 404</p>
        <h1 class="h1" style="font-size:clamp(40px,6vw,64px)">Diese Seite <span class="muted">gibt es nicht.</span></h1>
        <p>Vielleicht wurde sie verschoben. Auf der Startseite finden Sie alles Wichtige.</p>
        <a class="btn" href="/">Zur Startseite</a>
      </div>
    </main>
  </div>
  <MiniFooter />
</Base>
