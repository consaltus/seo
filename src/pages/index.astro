---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/utils';
const lang = 'de';
const t = useTranslations(lang);
---

<Base title={t('home.title')} description={t('home.description')} lang={lang} routeKey="home">
  <div class="container"><h1>{t('home.title')}</h1><p>Platzhalter, Inhalt folgt in Etappe 2.</p></div>
</Base>
